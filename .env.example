# Server only. Never prefix this variable with NEXT_PUBLIC_.
PREVISION_API_TOKEN=

# Painel do projeto Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Nunca prefixe com NEXT_PUBLIC_ — dá acesso total ao banco, ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Só em `next dev` e fora da Vercel: pula o login do Google e entra com este perfil (id de profiles).
# DEV_AUTH_BYPASS_PROFILE_ID=

# Server only. E-mails de quem desenvolve o sistema, separados por vírgula: só eles veem os módulos
# em desenvolvimento (longo prazo, vagões, médio prazo, federação, IFC, dívidas, integrações). Os
# demais usuários ficam no curto prazo. Vazio, vale o admin inicial (bruno.engenharia@...).
DEVELOPER_EMAILS=
