# Server only. Never prefix this variable with NEXT_PUBLIC_.
PREVISION_API_TOKEN=

# Painel do projeto Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Nunca prefixe com NEXT_PUBLIC_ — dá acesso total ao banco, ignorando RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Só em `next dev` e fora da Vercel: pula o login do Google e entra com este perfil (id de profiles).
# DEV_AUTH_BYPASS_PROFILE_ID=

# Opcional, server only. Segredo da assinatura dos cabeçalhos de identidade que o proxy repassa às
# rotas (x-obra360-*). Sem ela, a assinatura usa a chave de serviço.
# OBRA360_TRUSTED_HEADER_SECRET=

# Server only. E-mails de quem desenvolve o sistema, separados por vírgula: só eles veem os módulos
# em desenvolvimento (longo prazo, vagões, médio prazo, federação, IFC, dívidas, integrações). Os
# demais usuários ficam no curto prazo. Vazio, vale o admin inicial (bruno.engenharia@...).
DEVELOPER_EMAILS=

# Server only. Chave da API da Anthropic para o botão "Analisar com IA" do fechamento do curto prazo.
# Sem ela o botão avisa que a análise não está configurada; o resto da tela segue normal.
ANTHROPIC_API_KEY=

# Agente de IA (27/10/2026). A chave acima também serve ao agente; `API_ANTHROPIC` é aceita como apelido dela.
# Modelo do agente: id completo da Anthropic ou apelido (SONNET5.5, OPUS5.5, HAIKU5.5); `MODEL` é aceito como
# apelido desta variável. Padrão: claude-sonnet-5-5 (uma leitura de obra custa cerca de US$ 0,05).
AGENT_MODEL=
# Teto mensal em dólares para todas as obras (padrão 20). Cada obra pode usar até 1,5× a parte dela
# (teto ÷ obras ativas); o admin ainda pode dar limite por pessoa e cortar acesso em Configurações → Agente de IA.
AGENT_MONTHLY_BUDGET_USD=
# Nome da assistente na tela (padrão "Claudia"). Público: vai para o navegador.
NEXT_PUBLIC_AGENT_NAME=

# Opcional. Chave comercial do Open-Meteo (uso gratuito é só não comercial): liga os hosts customer-*.open-meteo.com.
OPEN_METEO_API_KEY=

# Opcional. Identificação enviada ao Nominatim (OpenStreetMap) na busca de endereço do local da obra.
GEOCODING_USER_AGENT=
